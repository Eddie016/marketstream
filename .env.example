MARKETSTREAM_ENVIRONMENT=local
MARKETSTREAM_LOG_LEVEL=INFO
MARKETSTREAM_DATABASE_URL=postgresql+psycopg://marketstream:marketstream@postgres:5432/marketstream
MARKETSTREAM_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MARKETSTREAM_S3_ENDPOINT_URL=http://minio:9000
MARKETSTREAM_S3_ACCESS_KEY=marketstream
MARKETSTREAM_S3_SECRET_KEY=marketstream-local-only
MARKETSTREAM_S3_BUCKET=marketstream

POSTGRES_USER=marketstream
POSTGRES_PASSWORD=marketstream
POSTGRES_DB=marketstream
MINIO_ROOT_USER=marketstream
MINIO_ROOT_PASSWORD=marketstream-local-only
